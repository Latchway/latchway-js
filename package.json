{
  "name": "@latchway/client",
  "version": "1.0.0",
  "description": "DPoP-bound browser and Node.js client for the Latchway AI gateway",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": "10.15.0"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "contract.lock"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latchway/latchway-js.git"
  },
  "bugs": {
    "url": "https://github.com/Latchway/latchway-js/issues"
  },
  "homepage": "https://github.com/Latchway/latchway-js#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./firebase": {
      "types": "./dist/firebase.d.ts",
      "import": "./dist/firebase.js"
    },
    "./turnstile": {
      "types": "./dist/turnstile.d.ts",
      "import": "./dist/turnstile.js"
    },
    "./service-worker": {
      "types": "./dist/service-worker.d.ts",
      "import": "./dist/service-worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && pnpm --recursive --filter './packages/**' run build",
    "browser:build": "vite build --config test/browser/vite.config.ts",
    "browser:install": "playwright install chromium firefox webkit",
    "bundlers:check": "node scripts/verify-web-bundlers.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:offline-release && pnpm build && pnpm examples:check && pnpm exports:check && pnpm web:verify",
    "docs:bundle": "python3 scripts/build_docs_bundle.py",
    "examples:check": "tsc -p tsconfig.examples.json --noEmit",
    "exports:check": "node scripts/verify-exports.mjs",
    "framework:install-profile": "node scripts/framework-matrix.mjs install",
    "framework:verify-profile": "node scripts/framework-matrix.mjs verify",
    "lint": "eslint . --max-warnings=0",
    "namespace:bootstrap": "node scripts/npm-namespace-bootstrap.mjs",
    "pack:check": "node scripts/verify-pack.mjs",
    "release:check": "node scripts/verify-release-candidate.mjs",
    "security:dependencies": "bash scripts/scan-dependencies.sh \"$(git rev-parse HEAD)\"",
    "test": "vitest run && node --test scripts/test-live-conformance.mjs scripts/test-npm-namespace-bootstrap.mjs scripts/test-npm-release-evidence.mjs scripts/test-verification-runtime.mjs && python3 scripts/test-dependency-vulnerability-scan.py",
    "test:offline-release": "python3 scripts/run-offline-release-tests.py",
    "test:framework": "vitest run test/framework-adapters.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --recursive --filter './packages/**' run typecheck",
    "verify:contracts": "node scripts/verify-contract.mjs",
    "verify:release-policy": "node scripts/verify-release-policy.mjs",
    "verify:reproducible": "node scripts/verify-reproducible.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "web:check": "pnpm build && pnpm web:verify",
    "web:verify": "pnpm browser:build && pnpm bundlers:check && playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.52",
    "@eslint/js": "10.0.1",
    "@langchain/openai": "1.5.10",
    "@playwright/test": "1.56.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "ai": "7.0.85",
    "eslint": "10.9.1",
    "fake-indexeddb": "6.2.5",
    "next": "16.3.3",
    "openai": "7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  },
  "keywords": [
    "dpop",
    "fetch",
    "gateway",
    "security"
  ]
}
