{
  "name": "@latchway/vercel-ai",
  "version": "1.0.0",
  "description": "Feature-bound Latchway provider adapter for the Vercel AI SDK",
  "license": "Apache-2.0",
  "engines": { "node": ">=24.19.0" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "NOTICE", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latchway/latchway-js.git",
    "directory": "packages/vercel-ai"
  },
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@ai-sdk/openai": "4.0.52",
    "@latchway/client": "workspace:^",
    "ai": "7.0.85"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
